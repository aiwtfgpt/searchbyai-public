{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searchbyai.com/schema/searchbyai-1.0.json",
  "title": "SearchByAI Node Manifest",
  "description": "How a node describes itself to the SearchByAI registry. Produced by connect.sh (humans) or by an agent following CONNECT.md, then POSTed to /api/register.",
  "type": "object",
  "required": [
    "manifest_version",
    "node"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0"
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "owner_email",
        "endpoint_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
          "description": "Public slug. Appears in the node's URL at /n/{id}."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tagline": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "owner_email": {
          "type": "string",
          "format": "email"
        },
        "endpoint_url": {
          "type": "string",
          "pattern": "^https?://",
          "description": "Base URL where this node is reachable."
        },
        "routing": {
          "type": "string",
          "enum": [
            "direct",
            "proxied"
          ],
          "default": "direct",
          "description": "direct: agents connect to endpoint_url themselves. proxied: calls route through the hub."
        },
        "location": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "country": {
              "type": "string",
              "default": "US"
            },
            "precision": {
              "type": "string",
              "enum": [
                "exact",
                "city",
                "region",
                "global"
              ],
              "default": "city",
              "description": "Use 'global' for nodes with no physical service area. 'exact' is reserved and is downgraded to 'city' on write."
            },
            "service_radius_km": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 20000,
              "description": "Radius served. null means not location-bound."
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "llm": {
          "type": "object",
          "description": "The model behind this node. Self-reported: the registry does not verify it. Omit entirely for nodes with no LLM, such as a pure CLI tool \u2014 that is different from a node that simply has not said.",
          "properties": {
            "provider": {
              "type": "string",
              "maxLength": 60,
              "description": "e.g. ollama, openai, anthropic, vllm"
            },
            "model": {
              "type": "string",
              "maxLength": 200,
              "description": "The exact tag served, e.g. gemma-4:e4b"
            },
            "context_window": {
              "type": "integer",
              "minimum": 1,
              "description": "Context length in tokens"
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "mcp",
              "api",
              "cli"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "invocation": {
            "type": "object",
            "description": "mcp: {transport,url,tools[]}. api: {method,path,content_type}. cli: {install,command,runtime}."
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "none",
                  "api_key",
                  "oauth2",
                  "bearer",
                  "basic",
                  "mtls"
                ],
                "default": "none"
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What this capability can touch. Read by humans and agents before connecting. Recommended: read:public, read:filesystem, read:images, read:database, write:filesystem, write:database, compute:cpu, compute:gpu, network:egress, exec:shell, pay:read, pay:write."
          },
          "input_schema": {
            "type": "object"
          },
          "output_schema": {
            "type": "object"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "unlisted"
            ],
            "default": "public"
          },
          "pricing": {
            "type": "object",
            "description": "What the operator says this costs. DISPLAY ONLY \u2014 SearchByAI is a directory and never sees a call, so nothing here is metered, invoiced or collected by the registry.",
            "properties": {
              "model": {
                "enum": [
                  "free",
                  "per_call",
                  "subscription",
                  "custom"
                ],
                "default": "free"
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "Required for per_call and subscription"
              },
              "currency": {
                "type": "string",
                "minLength": 3,
                "maxLength": 3,
                "description": "ISO 4217, e.g. USD. Required with amount"
              },
              "unit": {
                "type": "string",
                "maxLength": 40,
                "description": "e.g. execution, month, 1k tokens"
              },
              "notes": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "model"
            ]
          }
        }
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "headline": {
          "type": "string",
          "maxLength": 200
        },
        "body_md": {
          "type": "string",
          "maxLength": 20000
        },
        "connect_notes_md": {
          "type": "string",
          "maxLength": 10000
        },
        "links": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "url": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "logo_url": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "proof": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "well_known",
            "dns_txt",
            "none"
          ],
          "default": "well_known",
          "description": "How the node proves it controls endpoint_url. 'none' caps trust_score at 40."
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
